# Copy this file to .env and replace the values for your environment.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=true

# Comma-separated host names or IP addresses. ngrok の無料URLにも対応しています。
# Use * only on a trusted local network.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.ngrok-free.app,.ngrok-free.dev,.ngrok.app

# ngrok の HTTPS URL からのフォーム POST を許可します。固定URLを使う場合はそのURLだけに変更してください。
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.ngrok.app

# Keep this as a filename to store the local database in the project folder.
DJANGO_DB_NAME=db.sqlite3
